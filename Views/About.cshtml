@{
    ViewBag.Title = "A propos";
    ViewBag.PageTitle = "A propos";
    int onlineUsers = Models.User.GetOnlineUsers().Count();
}

<div class="aboutPage">
    <section class="aboutHero roundedBorder">
        <img src="~/WebApp.png" class="aboutLogo" alt="Logo PFI" />

        <div class="aboutHeroText">
            <h1>PFI</h1>
            <p>
                Application Web transactionnelle multi-usagers offrant une interface CRUD
                pour gerer des etudiants, des enseignants et des cours dans des fichiers JSON.
            </p>
        </div>

        <div class="aboutBadge" title="Usagers actuellement connectes">
            <span class="aboutBadgeLabel">Usagers en ligne</span>
            <span class="aboutBadgeValue">@onlineUsers</span>
        </div>
    </section>

    <section class="aboutCard roundedBorder">
        <h2>Contexte pedagogique</h2>
        <p>
            Cette application sert de demonstration dans le cadre du cours 420-KBD-LG
            - Developpement d'applications Web II.
        </p>
        <p>
            Le site n'est relie a aucune activite commerciale et le contenu partage est
            modere pour respecter l'ethique collegiale.
        </p>
    </section>

    <div class="aboutSplit">
        <section class="aboutCard roundedBorder">
            <h2>Auteur</h2>
            <dl class="aboutMeta">
                <dt>Nom</dt>
                <dd>Malek-Gabriel Khaterchi</dd>

                <dt>Matricule</dt>
                <dd>202275145</dd>

                <dt>Statut</dt>
                <dd>Etudiant en technique de l'informatique</dd>

                <dt>Etablissement</dt>
                <dd>College Lionel-Groulx</dd>

                <dt>Courriel</dt>
                <dd><a href="mailto:202275145@edu.clg.qc.ca">202275145@edu.clg.qc.ca</a></dd>
            </dl>
        </section>

        <section class="aboutCard roundedBorder">
            <h2>Publication</h2>
            <dl class="aboutMeta">
                <dt>Date de publication</dt>
                <dd>12 mai 2026</dd>

                <dt>Portee</dt>
                <dd>Demonstration pedagogique multi-usagers.</dd>

                <dt>Stockage de donnees</dt>
                <dd>Fichiers locaux JSON sur le serveur.</dd>
            </dl>
        </section>
    </div>
</div>