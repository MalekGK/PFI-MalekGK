@{
    ViewBag.Title = "Profs";
    ViewBag.PageTitle = "Profs";
    bool searchOn = ViewBag.SearchOn != null ? (bool)ViewBag.SearchOn : false;
    string keywords = ViewBag.Keywords != null ? (string)ViewBag.Keywords : "";
}

@if (searchOn)
{
    <div class="searchBarPanel" style="grid-template-columns:1fr;">
        <input id="TeachersKeywords" type="text" placeholder="Recherche" value="@keywords" />
    </div>
}

@RenderPage("~/Views/Shared/_CurrentSessionEditor.cshtml")

<div id="TeachersListContainer"><!-- Periodicaly refreshed --></div>

@section Scripts {
    <script>
        let teachersListPanel = null;
        let teachersKeyword = "@keywords";
        let teachersSearchTimer = null;

        $(() => {
            teachersListPanel = new AutoRefreshedPanel("TeachersListContainer", "@Url.Action("GetTeachers")", 5, teachersListPostRefresh);

            $("#TeachersKeywords").on("input", function () {
                clearTimeout(teachersSearchTimer);
                teachersSearchTimer = setTimeout(teachersApplySearch, 250);
            });
        });

        function teachersApplySearch() {
            teachersKeyword = $("#TeachersKeywords").val() || "";
            $.post("@Url.Action("SetSearch")", {
                keywords: teachersKeyword
            }, () => {
                teachersListPanel.refresh(true);
            });
        }

        function teachersListPostRefresh() {
            teachersHighlight();
        }

        function teachersHighlight() {
            if (teachersKeyword.trim().length > 0) {
                $("#TeachersListContainer .teacherToHighlight").each(function () {
                    highlight(teachersKeyword.toLocaleLowerCase(), this);
                });
            }
        }

        function toggleCurrentSessionEditor(forceShow = null) {
            if (forceShow == null)
                $("#CurrentSessionEditor").slideToggle(150);
            else if (forceShow)
                $("#CurrentSessionEditor").slideDown(150);
            else
                $("#CurrentSessionEditor").slideUp(150);
        }

        function saveCurrentSession() {
            let year = parseInt($("#CurrentSessionYear").val() || 0);
            let season = $("input[name='CurrentSessionSeason']:checked").val();
            $.post("@Url.Action("SetCurrentSession")", { year, season }, (caption) => {
                $(".currentSessionCaption").text(caption);
                toggleCurrentSessionEditor(false);
                teachersListPanel.refresh(true);
            });
        }
    </script>
}
