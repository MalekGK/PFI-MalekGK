@model List<Models.Teacher>
@{
    string sessionCaption = ViewBag.SessionCaption != null ? (string)ViewBag.SessionCaption : "Automne 2026";
}
<div class="listBoxPanel">
    @if (Model.Count == 0)
    {
        <div class="emptyZone">Aucun prof</div>
    }
    else
    {
        foreach (var item in Model)
        {
            <div class="TeacherListLayout">
                <a href="@Url.Action("Details", new { id = item.Id })">
                    <div class="teacherAvatar" style="background-image:url('@item.Avatar');"></div>
                    <div class="teacherCaptionLine">
                        <span class="teacherCode clickCode">@item.Code</span>
                        <span class="teacherToHighlight teacherName">@item.LastName @item.FirstName</span>
                    </div>
                </a>
            </div>
        }
    }
</div>
<div class="sessionFooter clickable" onclick="toggleCurrentSessionEditor(true)">
    Session courante : <span class="currentSessionCaption">@sessionCaption</span>
</div>
