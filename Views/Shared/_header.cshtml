@{
    string controller = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString().ToLower();
    string action = HttpContext.Current.Request.RequestContext.RouteData.Values["action"].ToString().ToLower();

    bool userConnected = Models.User.ConnectedUser != null;
    bool userIsAdmin = userConnected ? Models.User.ConnectedUser.IsAdmin : false;
    bool userCanWrite = userConnected ? Models.User.ConnectedUser.CanWrite : false;

    bool showTabs = (controller == "students" || controller == "courses" || controller == "teachers") && action == "list";
    bool hideSimpleHeader = (controller == "students" || controller == "courses" || controller == "teachers") && action == "details";
}

@if (showTabs)
{
    <div class="section roundedBorder">
        <div class="headerMenu">
            <a class="siteIcon" href="@(userConnected ? "/Students/List" : "/Accounts/Login")"></a>
            <div class="tabsHeader">
                <a href="/Students/List" class="tabLink @(controller == "students" ? "selectedTab" : "")">Etudiants</a>
                <a href="/Courses/List" class="tabLink @(controller == "courses" ? "selectedTab" : "")">Cours</a>
                <a href="/Teachers/List" class="tabLink @(controller == "teachers" ? "selectedTab" : "")">Profs</a>
            </div>

            <div class="menu">
                @if (userCanWrite)
                {
                    <a href="/@controller/Create" class="cmdIcon fa fa-circle-plus" title="Ajouter..."></a>
                }

                <a href="/@controller/ToggleSearch" class="cmdIcon fa fa-search" title="Recherche..."></a>

                <div class="dropdown">
                    <div data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="cmdIcon fa fa-bars" title="Menu"></i>
                    </div>
                    <div class="dropdown-menu dropdown-menu-end noselect">
                        <div class="dropdown-item item-layout"><i class="cmdIcon fa fa-square-xmark"></i><a href="/Accounts/About">About</a></div>
                        <div class="dropdown-divider"></div>
                        <div class="dropdown-item item-layout"><i class="menuIcon fa fa-address-card"></i><a href="/Accounts/EditProfil">Profil...</a></div>
                        <div class="dropdown-item item-layout"><i class="menuIcon fa fa-sign-out"></i><a href="/Accounts/Logout">Deconnexion...</a></div>
                        @if (userIsAdmin)
                        {
                            <div class="dropdown-divider"></div>
                            <div class="dropdown-item item-layout"><i class="menuIcon fa fa-users"></i><a href="/Accounts/ManageUsers">Gestion des usagers...</a></div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (!hideSimpleHeader)
{
    <div class="section roundedBorder">
        <div class="headerMenu">
            <a class="siteIcon" href="@(userConnected ? "/Students/List" : "/Accounts/Login")"></a>
            <div class="pageTitle">@ViewBag.PageTitle</div>

            @switch (action)
            {
                case "login":
                    break;
                case "subscribe":
                case "editprofil":
                    <div id="mainMenuPanel" class="menu">
                        <i class="cmdIcon submitCmd fa fa-circle-check" title="Soumettre"></i>
                        <a class="cmdIcon fa fa-square-xmark" title="Annuler" onclick="history.back()"></a>
                    </div>
                    break;
                case "create":
                case "edit":
                    <div id="mainMenuPanel" class="menu">
                        <i class="cmdIcon submitCmd fa fa-circle-check" title="Enregistrer"></i>
                        <a class="cmdIcon fa fa-square-xmark" title="Annuler" href="javascript:history.back()"></a>
                    </div>
                    break;
            }
        </div>
    </div>
}
