@model List<Models.Course>
@{
    string sessionCaption = ViewBag.SessionCaption != null ? (string)ViewBag.SessionCaption : "Automne 2026";
}
<div class="listBoxPanel">
    @if (Model.Count == 0)
    {
        <div class="emptyZone">Aucun cours</div>
    }
    else
    {
        for (int session = 1; session <= 6; session++)
        {
            var courses = Model.Where(c => c.Session == session).OrderBy(c => c.Code).ToList();
            if (courses.Count > 0)
            {
                <details id="course_details_@session" open>
                    <summary>Session @session</summary>
                    @foreach (var item in courses)
                    {
                        <div class="CoursesListLayout panelLine">
                            <a href="@Url.Action("Details", new { id = item.Id })">
                                <span class="courseCode clickCode">@item.Code</span>
                                <span class="courseToHighlight">@item.Title</span>
                            </a>
                        </div>
                    }
                </details>
            }
        }
    }
</div>
<div class="sessionFooter clickable" onclick="toggleCurrentSessionEditor(true)">
    Session courante : <span class="currentSessionCaption">@sessionCaption</span>
</div>
