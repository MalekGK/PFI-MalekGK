@{
    ViewBag.Title = "Cours";
    ViewBag.PageTitle = "Cours";
    bool searchOn = ViewBag.SearchOn != null ? (bool)ViewBag.SearchOn : false;
    string keywords = ViewBag.Keywords != null ? (string)ViewBag.Keywords : "";
}

@if (searchOn)
{
    <div class="searchBarPanel" style="grid-template-columns:1fr;">
        <input id="CoursesKeywords" type="text" placeholder="Recherche" value="@keywords" />
    </div>
}

@RenderPage("~/Views/Shared/_CurrentSessionEditor.cshtml")

<div id="CoursesListContainer"><!-- Periodicaly refreshed --></div>

@section Scripts {
    <script>
        let coursesListPanel = null;
        let coursesKeyword = "@keywords";
        let coursesSearchTimer = null;

        $(() => {
            coursesListPanel = new AutoRefreshedPanel("CoursesListContainer", "@Url.Action("GetCourses")", 5, coursesListPostRefresh);

            $("#CoursesKeywords").on("input", function () {
                clearTimeout(coursesSearchTimer);
                coursesSearchTimer = setTimeout(coursesApplySearch, 250);
            });
        });

        function coursesApplySearch() {
            coursesKeyword = $("#CoursesKeywords").val() || "";
            $.post("@Url.Action("SetSearch")", {
                keywords: coursesKeyword
            }, () => {
                coursesListPanel.refresh(true);
            });
        }

        function coursesListPostRefresh() {
            RestoreDetailsState();
            SummaryHandling();
            coursesHighlight();
        }

        function coursesHighlight() {
            if (coursesKeyword.trim().length > 0) {
                $("#CoursesListContainer .courseToHighlight").each(function () {
                    highlight(coursesKeyword.toLocaleLowerCase(), this);
                });
            }
        }

        function toggleCurrentSessionEditor(forceShow = null) {
            if (forceShow == null)
                $("#CurrentSessionEditor").slideToggle(150);
            else if (forceShow)
                $("#CurrentSessionEditor").slideDown(150);
            else
                $("#CurrentSessionEditor").slideUp(150);
        }

        function saveCurrentSession() {
            let year = parseInt($("#CurrentSessionYear").val() || 0);
            let season = $("input[name='CurrentSessionSeason']:checked").val();
            $.post("@Url.Action("SetCurrentSession")", { year, season }, (caption) => {
                $(".currentSessionCaption").text(caption);
                toggleCurrentSessionEditor(false);
                coursesListPanel.refresh(true);
            });
        }
    </script>
}
