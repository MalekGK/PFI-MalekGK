@model Models.User
@{
    ViewBag.Title = "Nouveau compte";
    ViewBag.PageTitle = "Nouveau compte";

    string formError = ViewBag.FormError != null ? (string)ViewBag.FormError : "";
    string notifyChecked = Model != null && Model.Notify ? "checked" : "";
    string avatar = Model != null && !string.IsNullOrWhiteSpace(Model.Avatar)
        ? Model.Avatar
        : "/App_Assets/Users/no_avatar.png";
}

<form id="subscribeForm" method="post" action="@Url.Action("Subscribe", "Accounts")">
    <div class="profil-form">
        @if (!string.IsNullOrWhiteSpace(formError))
        {
            <fieldset>
                <legend><i class="fa fa-triangle-exclamation" style="color:red; font-size:20px;"></i></legend>
                <div class="accountLegendMessage" style="color:red;">@formError</div>
            </fieldset>
        }

        <fieldset>
            <legend>Nom</legend>
            <input name="Name"
                   id="Name"
                   class="form-control"
                   placeholder="Nom"
                   required
                   value="@Model.Name" />
        </fieldset>

        <fieldset>
            <legend>Courriel</legend>
            <input name="Email"
                   id="Email"
                   class="form-control"
                   type="email"
                   placeholder="Courriel"
                   required
                   value="@Model.Email" />
            <input id="ConfirmEmail"
                   name="ConfirmEmail"
                   class="form-control"
                   type="email"
                   placeholder="Confirmation"
                   required
                   value="@Model.Email" />
        </fieldset>

        <fieldset>
            <legend>Mot de passe</legend>
            <div class="passwordLayout">
                <input name="Password"
                       id="Password"
                       class="form-control"
                       type="password"
                       placeholder="Mot de passe"
                       required />
                <i id="toggleShowPassword" class="passwordShowIcon fa fa-eye" title="Afficher/Masquer le mot de passe"></i>
            </div>
            <div class="passwordLayout">
                <input id="ConfirmPassword"
                       name="ConfirmPassword"
                       class="form-control"
                       type="password"
                       placeholder="Confirmation"
                       required />
            </div>
        </fieldset>

        <fieldset>
            <legend>Notifications</legend>
            <div class="profilCheckRow">
                <input type="checkbox" name="NotifyCB" id="NotifyCB" @notifyChecked />
                <span></span>
                <label for="NotifyCB">Activees</label>
            </div>
        </fieldset>

        <fieldset>
            <legend>Avatar</legend>
            @Helper.ImageUploader("Avatar", avatar, "Cliquez glisser une photo")
        </fieldset>

        <input id="submit" type="submit" style="display:none" />
    </div>
</form>

<div class="event-form" style="margin-top:8px;">
    <div class="accountActionLinks">
        <a href="/Accounts/Login">Retour a la connexion...</a>
    </div>
</div>

@section Scripts {
    <script>
        $(() => {
            let showPassword = false;

            if ($("#Password").val() === "")
                $("#toggleShowPassword").hide();

            $("#toggleShowPassword").click(() => {
                showPassword = !showPassword;
                if (showPassword) {
                    $("#Password").attr("type", "text");
                    $("#ConfirmPassword").attr("type", "text");
                    $("#toggleShowPassword").removeClass("fa-eye").addClass("fa-eye-slash");
                } else {
                    $("#Password").attr("type", "password");
                    $("#ConfirmPassword").attr("type", "password");
                    $("#toggleShowPassword").removeClass("fa-eye-slash").addClass("fa-eye");
                }
            });

            $("#Password").on("input", () => {
                if ($("#Password").val() === "")
                    $("#toggleShowPassword").hide();
                else
                    $("#toggleShowPassword").show();
            });

            $("#subscribeForm").on("submit", function (e) {
                let email = ($("#Email").val() || "").trim();
                let confirmEmail = ($("#ConfirmEmail").val() || "").trim();
                let password = $("#Password").val() || "";
                let confirmPassword = $("#ConfirmPassword").val() || "";

                if (email !== confirmEmail) {
                    alert("Les courriels ne correspondent pas.");
                    e.preventDefault();
                    return;
                }

                if (password !== confirmPassword) {
                    alert("Les mots de passe ne correspondent pas.");
                    e.preventDefault();
                    return;
                }
            });
        });
    </script>
}
