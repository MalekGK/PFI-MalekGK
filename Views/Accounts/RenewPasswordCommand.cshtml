@model Models.EmailView
@{
    ViewBag.Title = "Reinitialisation de mot de passe";
    ViewBag.PageTitle = "Reinitialisation de mot de passe";
    bool emailNotFound = ViewBag.EmailNotFound != null ? (bool)ViewBag.EmailNotFound : false;
}

<br />
<form method="post" action="@Url.Action("RenewPasswordCommand", "Accounts")">
    <div class="event-form">
        <fieldset>
            <legend>Adresse de courriel</legend>
            <input name="Email" id="Email"
                   class="form-control"
                   type="email"
                   placeholder="Courriel"
                   required
                   value="@(Model != null ? Model.Email : "")" />

            @if (emailNotFound)
            {
                <div class="text-danger" style="text-align:left;">Courriel introuvable</div>
            }

            <input type="submit" value="Soumettre" class="btn btn-primary" />
        </fieldset>
    </div>
</form>
