@model Models.RenewPasswordView
@{
    ViewBag.Title = "Renouvellement de mot de passe";
    ViewBag.PageTitle = "Renouvellement de mot de passe";
    string formError = ViewBag.FormError != null ? (string)ViewBag.FormError : "";
}

<br />
@using (Html.BeginForm("RenewPassword", "Accounts", FormMethod.Post, new { id = "renewPasswordForm" }))
{
    <input id="Code" name="Code" type="hidden" value="@(Model != null ? Model.Code : "")" />
    <div class="event-form">
        @if (!string.IsNullOrWhiteSpace(formError))
        {
            <fieldset>
                <legend><i class="fa fa-triangle-exclamation" style="color:red; font-size:20px;"></i></legend>
                <div class="accountLegendMessage" style="color:red;">@formError</div>
            </fieldset>
        }

        <fieldset>
            <legend>Mot de passe</legend>
            <div class="passwordLayout">
                <input name="Password"
                       id="Password"
                       class="form-control"
                       type="password"
                       placeholder="Mot de passe"
                       required />
                <i id="toggleShowPassword" class="passwordShowIcon fa fa-eye" title="Afficher/Masquer le mot de passe"></i>
            </div>

            <div class="passwordLayout">
                <input id="ConfirmPassword"
                       name="ConfirmPassword"
                       class="form-control"
                       type="password"
                       placeholder="Confirmation"
                       required />
            </div>
        </fieldset>

        <input id="submit" type="submit" value="Soumettre" class="btn btn-primary" />
    </div>
}

@section Scripts {
    <script>
        $(() => {
            if ($("#Password").val() === "")
                $("#toggleShowPassword").hide();

            $("#toggleShowPassword").click(() => {
                $("#Password").attr("type", $("#Password").attr("type") === "password" ? "text" : "password");
                $("#ConfirmPassword").attr("type", $("#ConfirmPassword").attr("type") === "password" ? "text" : "password");
                $("#toggleShowPassword").toggleClass("fa-eye");
                $("#toggleShowPassword").toggleClass("fa-eye-slash");
            });

            $("#Password").on("input", () => {
                if ($("#Password").val() === "")
                    $("#toggleShowPassword").hide();
                else
                    $("#toggleShowPassword").show();
            });

            $("#renewPasswordForm").on("submit", function (e) {
                let password = $("#Password").val() || "";
                let confirmPassword = $("#ConfirmPassword").val() || "";
                if (password !== confirmPassword) {
                    alert("Les mots de passe ne correspondent pas.");
                    e.preventDefault();
                }
            });
        });
    </script>
}
