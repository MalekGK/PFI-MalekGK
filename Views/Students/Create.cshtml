@model Models.Student
@{
    ViewBag.Title = "Etudiant - Ajout";
    ViewBag.PageTitle = "Etudiant - Ajout";
}

<div class="formCard">
    <form method="post" action="@Url.Action("Create", "Students")">
        <details id="student_create_info_details" open>
            <summary>Informations - [Nouveau]</summary>
            <div class="form-group">
                <label for="FirstName">Prenom</label>
                <input id="FirstName" name="FirstName" type="text" value="@Model.FirstName" />
            </div>

            <div class="form-group">
                <label for="LastName">Nom</label>
                <input id="LastName" name="LastName" type="text" value="@Model.LastName" />
            </div>

            <div class="form-group">
                <label for="BirthDate">Date de naissance</label>
                <input id="BirthDate" name="BirthDate" type="date" value="@(Model.BirthDate.Year > 1900 ? Model.BirthDate.ToString("yyyy-MM-dd") : "")" />
            </div>

            <div class="form-group">
                <label for="Email">Courriel</label>
                <input id="Email" name="Email" type="email" value="@Model.Email" />
            </div>

            <div class="form-group">
                <label for="Phone">Telephone</label>
                <input id="Phone" name="Phone" class="phone" type="text" value="@Model.Phone" />
            </div>

            <div class="form-group">
                <label for="AdmissionYear">Annee d'admission</label>
                <input id="AdmissionYear" name="AdmissionYear" type="number" min="2020" max="2099" value="@Model.AdmissionYear" />
            </div>
        </details>
        <button id="submit" type="submit" style="display:none"></button>
    </form>
</div>
