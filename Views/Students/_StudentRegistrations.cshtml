@model Models.Student
@{
    var yearsList = Model.Registrations.Select(r => r.Year).Distinct().OrderByDescending(y => y).ToList();
}
<div class="detailsCard">
    <div class="registrationsTitle">Inscriptions</div>
    @if (Model.Registrations.Count == 0)
    {
        <div class="emptyZone">Aucune inscription</div>
    }
    else
    {
        foreach (int year in yearsList)
        {
            var registrations = Model.Registrations.Where(r => r.Year == year).ToList();
            if (registrations.Count > 0)
            {
                <details id="student_registrations_details_@year" open>
                    <summary>@year</summary>
                    @foreach (var registration in registrations)
                    {
                        <div class="panelLine">
                            <a href="@Url.Action("Details", "Courses", new { id = registration.CourseId })">
                                <span style="color:#8391a0;">[@registration.Course.Session]</span>
                                <span class="clickCode">@registration.Course.Code</span>
                                @registration.Course.Title
                            </a>
                        </div>
                    }
                </details>
            }
        }
    }
</div>
